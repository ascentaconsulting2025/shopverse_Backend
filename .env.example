SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
PORT=5000
# Comma-separated origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"
# Supabase account emails that may access the admin dashboard.
ADMIN_EMAILS="admin@example.com"
# Required only for `npm run seed:demo`; the command creates this confirmed demo account if needed.
DEMO_OWNER_EMAIL="demo-owner@example.com"
DEMO_OWNER_PASSWORD="replace-with-a-strong-password"

# Optional: comma-separated deployment proxy IPs/CIDRs for protected profile view counting.
TRUSTED_PROXY_CIDRS=

# Persistent sessions expire absolutely after this many days (1-90).
SESSION_DAYS=30
# Use production behind HTTPS so refresh cookies are Secure.
NODE_ENV=development
# lax for same-site frontend/API; none only for an HTTPS cross-site deployment.
AUTH_COOKIE_SAME_SITE=lax
