SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
PORT=5000
# Comma-separated origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"
# Supabase account emails that may access the admin dashboard.
ADMIN_EMAILS="admin@example.com"
# Required only for `npm run seed:demo`; the command creates this confirmed demo account if needed.
DEMO_OWNER_EMAIL="demo-owner@example.com"
DEMO_OWNER_PASSWORD="replace-with-a-strong-password"
