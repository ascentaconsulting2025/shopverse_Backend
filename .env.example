SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
PORT=5000
# Comma-separated origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"
# Supabase account emails that may access the admin dashboard.
ADMIN_EMAILS="admin@example.com"
# Required only for `npm run seed:demo`; the command creates this confirmed demo account if needed.
DEMO_OWNER_EMAIL="demo-owner@example.com"
DEMO_OWNER_PASSWORD="replace-with-a-strong-password"

# Optional: comma-separated trusted proxy IPs/CIDRs. On Render, the immediate
# proxy is trusted automatically when this setting is empty.
TRUSTED_PROXY_CIDRS=

# Persistent sessions expire absolutely after this many days (1-90).
SESSION_DAYS=30
# Use production behind HTTPS so refresh cookies are Secure.
NODE_ENV=development
# lax for same-site frontend/API; none only for an HTTPS cross-site deployment.
AUTH_COOKIE_SAME_SITE=lax

# Enable only after migration 035 and database admin allowlist verification.
BUSINESS_ACCESS_ENABLED=false
BUSINESS_INVITATION_DAYS=7
PUBLIC_APP_URL=
# HTTPS transactional-email adapter; contract in docs/business-access-implementation.md.
BUSINESS_INVITATION_DELIVERY_URL=
BUSINESS_INVITATION_DELIVERY_SECRET=
